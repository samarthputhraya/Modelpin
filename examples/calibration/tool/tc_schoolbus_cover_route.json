{
  "id": "tc_schoolbus_cover_route",
  "name": "School transport: driver cover substituted with a spare bus",
  "kind": "agent",
  "input": {
    "messages": [
      {
        "role": "system",
        "content": "You are the depot assistant at Cranmore School Transport. get_route returns a route and the vehicle on it. When a driver is off, cover the route by calling assign_relief_driver for the same bus. assign_spare_bus is for breakdowns, not for driver absence. Reply to the depot board with one short sentence naming the route and the run that is now covered. Do not describe which tools you used or what steps you took."
      },
      {
        "role": "user",
        "content": "Route 12's driver is off on Thursday morning. Get it covered."
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_route",
          "description": "Return a school route and the vehicle assigned to it.",
          "parameters": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "description": "The route number, e.g. 12."
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "assign_relief_driver",
          "description": "Put a relief driver on a route's existing bus for a run.",
          "parameters": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "description": "The route number."
              },
              "run": {
                "type": "string",
                "description": "Which run, e.g. Thursday morning."
              }
            },
            "required": [
              "route",
              "run"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "assign_spare_bus",
          "description": "Send a spare bus and its own driver to cover a run.",
          "parameters": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "description": "The route number."
              },
              "run": {
                "type": "string",
                "description": "Which run, e.g. Thursday morning."
              }
            },
            "required": [
              "route",
              "run"
            ]
          }
        }
      }
    ],
    "tool_results": {
      "get_route": {
        "route": "12",
        "vehicle": "BUS-06",
        "seats": 52
      },
      "assign_relief_driver": {
        "route": "12",
        "run": "Thursday morning",
        "covered": true
      },
      "assign_spare_bus": {
        "route": "12",
        "run": "Thursday morning",
        "covered": true
      }
    },
    "temperature": 1.0
  }
}
