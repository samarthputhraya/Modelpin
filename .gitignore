__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.env.*
.pytest_cache/
.ruff_cache/
.DS_Store
*.log

# Local Modelpin state: ignore transient outputs (rendered report, temp files) but ALLOW
# committing recorded baselines — the migration flow commits the known-good baseline so CI
# can diff a candidate model against it. (Re-include needs `.modelpin/*`, not `.modelpin/`.)
.modelpin/*
!.modelpin/baseline-*.json

# Ad-hoc calibration re-run scratch output (committed evidence snapshots live in
# examples/calibration/results/ instead — see that dir + docs/STATUS.md).
scripts/_calibration_*.json

# Windows reserved device name accidentally materialized by `>nul` redirects
# under Git Bash (it's a real file there, not the null device). Never track it.
nul

# Internal / GTM docs — kept LOCAL to the maintainer, never published (open-core split:
# the free CLI/engine/Action is open; roadmap, internal process notes, and the launch/sales
# playbook stay private). These files remain on disk for local use, just untracked.
/ops/

# A contributor's OWN Modelpin setup, made by following the README in a clone
# (`git clone` -> `pip install -e .` -> `mp init`). These must never become tracked: a
# tracked root `modelpin.yaml` is the path the CLI loads by default, so it would become
# the config of everyone who clones this repo, and `mp baseline` would spend their key on
# whatever it points at. That is MP-32; this repo's dogfood config lives in .github/ and
# the workflow passes it with `config:`. tests/test_first_run_cost.py asserts on it.
/modelpin.yaml
/scenarios/

# pytest-cov output
.coverage
